# --- Required ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Recommended (raises Semantic Scholar rate limit from the shared free tier) ---
SEMANTIC_SCHOLAR_API_KEY=

# --- Reviewer/confidence judge model (kept separate from the generator on purpose) ---
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Optional overrides ---
GEMINI_MODEL=gemini-2.5-flash
DATABASE_PATH=ares.db
ACS_CONFIDENCE_WEIGHT=0.40
ACS_EVIDENCE_WEIGHT=0.35
ACS_COMPLETION_WEIGHT=0.25
ACS_RETRY_THRESHOLD=0.6
